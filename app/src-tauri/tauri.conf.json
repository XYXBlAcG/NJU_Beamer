{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NJU Beamer",
  "version": "0.1.0",
  "identifier": "edu.nju.beamer.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NJU Beamer GUI Editor",
        "width": 1440,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 680,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: blob: data:; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; frame-src 'self' blob:; object-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Productivity",
    "icon": ["icons/icon.png"],
    "resources": {
      "../../templates/nju/NJU.sty": "templates/nju/NJU.sty",
      "../../templates/nju/pic": "templates/nju/pic"
    },
    "fileAssociations": [
      {
        "ext": ["njub"],
        "name": "NJU Beamer 文稿",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "application/vnd.nju-beamer+zip",
        "exportedType": {
          "identifier": "edu.nju.beamer.document",
          "conformsTo": ["public.zip-archive"]
        }
      }
    ]
  }
}
