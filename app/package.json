{
  "name": "nju-beamer-editor",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "bin": {
    "njub": "dist-cli/njub.mjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build && npm run build:cli",
    "build:cli": "tsc --noEmit -p tsconfig.cli.json && tsup",
    "njub": "tsx cli/index.ts",
    "test": "vitest run",
    "verify:catalogue": "node --import tsx verification/catalogue.ts",
    "generate:thumbnails": "node --import tsx verification/thumbnails.ts",
    "generate:themes": "node --import tsx verification/theme-thumbnails.ts",
    "generate:toolbox": "node --import tsx verification/toolbox.ts",
    "verify:toolbox": "node --import tsx verification/toolbox-compile.ts",
    "vendor:tikz": "node --import tsx verification/vendor-tikz.ts",
    "vendor:thesis": "node --import tsx verification/vendor-thesis.ts",
    "vendor:emblems": "node --import tsx verification/vendor-emblems.ts",
    "verify:papers": "node --import tsx verification/papers.ts",
    "verify:document": "node --import tsx verification/document.ts",
    "verify:interactions": "node --import tsx verification/editor-interactions.ts",
    "verify:rendering": "node --import tsx verification/render-regression.ts",
    "verify:presentation-features": "node --import tsx verification/presentation-features.ts",
    "verify:compile-performance": "node --import tsx verification/compile-performance.ts",
    "tauri": "tauri"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-select": "^2.2.6",
    "@retorquere/bibtex-parser": "^11.0.0",
    "@tanstack/react-virtual": "^3.14.13",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tiptap/extension-color": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-text-style": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "commander": "^15.0.0",
    "fflate": "^0.8.3",
    "katex": "^0.18.9",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.2",
    "@tauri-apps/cli": "^2.8.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vite-plugin-static-copy": "^3.1.4",
    "vitest": "^3.2.0"
  }
}
